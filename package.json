{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio site build tooling",
  "scripts": {
    "build:dist": "rm -rf dist && mkdir -p dist && cp -R index.html styles.css assets lib projects dist && [ ! -e forms ] || cp -R forms dist",
    "build": "npm run build:dist",
    "start": "npm run build && node server.js",
    "dev:server": "nodemon server.js",
    "dev": "npm run dev:server"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
